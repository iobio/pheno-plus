{
  "name": "pheno-plus",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup:config": "node scripts/setup-config.mjs",
    "predev": "npm run setup:config",
    "dev": "vite",
    "build": "npm run build:production",
    "build:staging": "npm run setup:config && vite build --base /phenoplus/oauth2/redirect/",
    "build:production": "npm run setup:config && vite build --base /launch/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "sql.js": "^1.10.3",
    "vue": "^3.3.4",
    "fhirclient": "^2.6.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.2",
    "@vitejs/plugin-vue": "^4.3.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "prettier": "^3.0.0",
    "vite": "^4.4.9"
  }
}
